import requests
from logger_setup import global_logger as logger


class LLMProcessor:
    """
    智能处理与输出系统核心逻辑，负责调用配置的 LLM API 进行推理处理。
    """

    def __init__(self, api_token: str, base_url: str, model: str, timeout: int = 60, retry: int = 3):
        self.api_token = api_token
        self.base_url = base_url.rstrip("/")
        self.model = model
        self.timeout = timeout
        self.retry = retry

    def generate(self, prompt: str) -> str:
        """
        根据提供的 prompt，调用 LLM API 获取处理后的结果输出。
        此处兼容类似 OpenAI 的 API 格式，支持自定义 Base URL。
        """
        headers = {
            "Authorization": f"Bearer {self.api_token}",
            "Content-Type": "application/json"
        }

        payload = {
            "model": self.model,
            "messages": [
                {"role": "user", "content": prompt}
            ],
            "temperature": 0.7
        }

        url = f"{self.base_url}/chat/completions"
        if not self.base_url.endswith("/v1") and "openai.com" in self.base_url:
            url = f"{self.base_url}/v1/chat/completions"
        elif not self.base_url.endswith("/v1") and not self.base_url.endswith("/chat/completions"):
            # 有些兼容接口自带 /v1 或者不需要 /v1
            # 这里保守一点，如果用户没有加 /v1 且也不是完整的 endpoint 路径，尝试做简单判断
            # 但最标准的方式是要求 base_url 以 /v1 结尾或者就是完整的 base。
            # 为了兼容大部分情况，我们如果发现它结尾不是 /v1 且没有包含 v1，我们帮他加
            if "/v1" not in self.base_url:
                url = f"{self.base_url}/v1/chat/completions"

        # 简单重试逻辑
        for attempt in range(self.retry):
            try:
                logger.info(f"第 {attempt + 1} 次请求 LLM 服务... URL: {url}")
                response = requests.post(url, headers=headers, json=payload, timeout=self.timeout)
                response.raise_for_status()

                result_json = response.json()
                return result_json["choices"][0]["message"]["content"]

            except requests.exceptions.RequestException as e:
                error_msg = str(e)
                if hasattr(e, 'response') and e.response is not None:
                    error_msg += f" | 响应详情: {e.response.text}"
                logger.error(f"LLM 请求失败: {error_msg}")
                if attempt == self.retry - 1:
                    raise Exception(f"已达到最大重试次数，LLM 响应失败。最后一次报错: {error_msg}")

        return "未能生成结果"
