def _parse_json_from_text(text: str):
    """
    从任意 LLM 文本中尽力解析出 JSON。
    适配常见情况：
    1) 直接返回 JSON；
    2) Markdown 代码块 ``` ... ```（或 ```json ... ```）内包含 JSON；
    3) 文本前后有解释，但中间夹着一段 JSON。
    返回 (parsed_obj, extracted_json_text)；若无法解析则返回 (None, "")。
    """
    import json as _json
    import re as _re

    s = str(text or "").strip()
    if not s:
        return None, ""

    def _try_load(candidate: str):
        c = str(candidate or "").strip()
        if not c:
            return None, ""
        try:
            return _json.loads(c), c
        except Exception:
            return None, ""

    # 1) 直接解析
    obj, used = _try_load(s)
    if obj is not None:
        return obj, used

    # 2) 尝试从 ``` ``` 中提取
    for m in _re.finditer(r"```(?:json|JSON)?\s*([\s\S]*?)```", s, flags=_re.MULTILINE):
        obj, used = _try_load(m.group(1))
        if obj is not None:
            return obj, used

    # 3) 兜底：截取第一段看起来像 JSON 的子串
    first = s.find("{")
    last = s.rfind("}")
    if first != -1 and last != -1 and last > first:
        obj, used = _try_load(s[first:last + 1])
        if obj is not None:
            return obj, used
    first = s.find("[")
    last = s.rfind("]")
    if first != -1 and last != -1 and last > first:
        obj, used = _try_load(s[first:last + 1])
        if obj is not None:
            return obj, used

    return None, ""


def _extract_kv_from_text(text: str, *, limit: int = 180):
    """
    从“已清洗后的页面文本”中抽取可读的键值对，给 LLM 一个更稳定的结构化输入。
    支持两类常见版式：
    1) 同行：标签: 值
    2) 上下行：标签（上一行） + 值（下一行）
    返回 dict[str, str]
    """
    import re as _re

    s = str(text or "")
    if not s.strip():
        return {}

    lines = [x.strip() for x in s.splitlines()]
    lines = [x for x in lines if x]

    out = {}

    def _is_heading(t: str) -> bool:
        return bool(t.startswith("===") and t.endswith("==="))

    def _looks_like_label(t: str) -> bool:
        if not t:
            return False
        if _is_heading(t):
            return False
        if len(t) > 14:
            return False
        if "http" in t.lower() or "javascript" in t.lower():
            return False
        if _re.search(r"[:：]", t):
            return False
        if _re.fullmatch(r"[\d\-/\.]+", t):
            return False
        if t in ["流程表单", "流程图", "流程状态", "相关资源", "打 印", "打印", "表单日志", "打印日志", "收藏", "信息填写"]:
            return False
        return True

    def _looks_like_value(t: str) -> bool:
        if not t:
            return False
        if _is_heading(t):
            return False
        if len(t) > 220:
            return False
        return True

    for line in lines:
        m = _re.match(r"^(.{1,30})[：:]\s*(.{1,200})$", line)
        if not m:
            continue
        k = (m.group(1) or "").strip()
        v = (m.group(2) or "").strip()
        if not k or not v:
            continue
        if "http" in k.lower() or "javascript" in k.lower():
            continue
        if k not in out:
            out[k[:40]] = v[:200]
        if len(out) >= limit:
            break

    i = 0
    while i + 1 < len(lines):
        k = lines[i]
        v = lines[i + 1]
        if _looks_like_label(k) and _looks_like_value(v):
            if k not in out:
                out[k[:40]] = v[:200]
            i += 2
            if len(out) >= limit:
                break
            continue
        i += 1

    # 额外增强：识别 OA 常见“表格区块”（如 关联合同信息），补出关键字段
    try:
        def _find_first(start: int, needle: str, *, max_scan: int = 600) -> int:
            end = min(len(lines), start + max_scan)
            for j in range(start, end):
                if lines[j] == needle:
                    return j
            return -1

        sec = _find_first(0, "关联合同信息", max_scan=2000)
        if sec != -1:
            head = _find_first(sec, "合同编码", max_scan=900)
            if head != -1:
                end = min(len(lines), head + 260)
                code = ""
                for j in range(head, end - 1):
                    if lines[j] == "1":
                        cand = lines[j + 1].strip()
                        if cand and _re.search(r"[A-Za-z]", cand) and _re.search(r"\d", cand) and len(cand) >= 8:
                            code = cand[:200]
                            break
                if not code:
                    for j in range(head, end):
                        cand = lines[j].strip()
                        if not cand:
                            continue
                        if cand in ["序号", "合同编码", "供应商名称", "我司主体", "账期", "合同状态", "合同开始时间", "合同结束时间", "币种", "签约金额", "附件", "uuid", "查看详情"]:
                            continue
                        if _re.fullmatch(r"\d+", cand):
                            continue
                        if _re.search(r"[A-Za-z]", cand) and _re.search(r"\d", cand) and len(cand) >= 8:
                            code = cand[:200]
                            break
                contract_headers = ["序号", "合同编码", "供应商名称", "我司主体", "账期", "合同状态", "合同开始时间", "合同结束时间", "币种", "签约金额", "附件", "uuid", "查看详情"]
                if code and (("合同编码" not in out) or (str(out.get("合同编码") or "").strip() in contract_headers)):
                    out["合同编码"] = code
    except Exception:
        pass

    # 额外增强：识别 OA 常见“关联发票信息”表格，补出发票查验状态（给规则判断提供客观输入）
    try:
        def _should_override(existing: str, header_labels: list) -> bool:
            e = str(existing or "").strip()
            return (not e) or (e in header_labels)

        def _find_first2(start: int, needle: str, *, max_scan: int = 600) -> int:
            end = min(len(lines), start + max_scan)
            for j in range(start, end):
                if lines[j] == needle:
                    return j
            return -1

        contract_headers = ["序号", "合同编码", "供应商名称", "我司主体", "账期", "合同状态", "合同开始时间", "合同结束时间", "币种", "签约金额", "附件", "uuid", "查看详情"]
        if "合同编码" in out and _should_override(out.get("合同编码", ""), contract_headers):
            out.pop("合同编码", None)

        sec = _find_first2(0, "关联发票信息", max_scan=2600)
        if sec != -1:
            status_candidates = ["有效已查验", "已查验", "有效未查验", "未查验", "查验失败", "无效", "已作废"]
            end = min(len(lines), sec + 4000)
            inv_code = ""
            for j in range(sec, end):
                t = lines[j].strip()
                if t.startswith("#") and len(t) >= 6:
                    inv_code = t[:200]
                    break
            inv_status = ""
            if inv_code:
                start = _find_first2(sec, inv_code, max_scan=4000)
                if start != -1:
                    for j in range(start, min(len(lines), start + 120)):
                        t = lines[j].strip()
                        if t in status_candidates:
                            inv_status = t
                            break
            invoice_headers = ["序号", "发票编码", "销售方", "购买方", "开票日期", "发票类型", "价税合计", "税额", "税率", "查验状态", "操作", "发票", "发票关联文件json"]
            if inv_code and _should_override(out.get("发票编码", ""), invoice_headers):
                out["发票编码"] = inv_code
            if inv_status and _should_override(out.get("发票查验状态", ""), status_candidates + invoice_headers):
                out["发票查验状态"] = inv_status
    except Exception:
        pass

    return out


@app.post("/api/llm/config")
def save_llm_config(config: LLMConfig):
    """
    保存 LLM 连接配置信息到本地加密存储
    """
    existing = secret_store.load_config()
    merged = dict(existing)
    merged.update(config.dict())
    secret_store.save_config(merged)
    return {"status": "success", "message": "配置保存成功"}


@app.get("/api/llm/config")
def get_llm_config():
    """
    获取当前解密后的 LLM 连接配置信息（不包含真实 token）
    """
    config = secret_store.load_config()
    if "api_token" in config:
        config["api_token"] = "********"  # 返回打码后的结果保证安全
    return config


